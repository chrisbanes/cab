{
  "name": "ensemble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.2.0",
  "bin": {
    "ensemble": "dist/src/cli/main.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "service": "node dist/src/standalone/cli.js",
    "operations": "node dist/src/standalone/operations-cli.js",
    "operator-auth": "npm run build && node dist/src/standalone/operator-auth-cli.js",
    "build": "npm run build:service && npm run build:web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:fixture-preflight": "npm run build && node scripts/run-tests.mjs --fixture-preflight",
    "s04b:view": "node test/s04b/local-view.mjs",
    "s04b:live": "node test/s04b/live-runtime.mjs --live",
    "s04d:live": "node test/s04d/live-operator.mjs --live",
    "cli7:live": "node test/cli7/live-diagnostics.mjs --live --one-attempt",
    "cli8:live": "node test/cli8/live-journey.mjs --live --max-turns 2",
    "c5:live": "node test/c5/live-journeys.mjs",
    "s05:live": "node test/s05/live-journey.mjs",
    "s05:routing": "node test/s05/live-routing.mjs",
    "s03b:live": "node test/s03b/live-runtime.mjs --live",
    "s08a:live": "node test/s08a/live-operations.mjs",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build:service": "tsc",
    "build:web": "vite build --config web/vite.config.ts",
    "ui01:live": "node test/ui01/runtime-contract.mjs --live --phase service"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "@typesafe-ai/sdk": "0.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
